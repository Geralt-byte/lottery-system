<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xjtu.infrastructure.persistent.dao.IRaffleActivitySkuDao">

    <select id="queryActivitySku" resultType="com.xjtu.infrastructure.persistent.po.RaffleActivitySku">
        select sku,
               activity_id,
               activity_count_id,
               stock_count,
               stock_count_surplus,
               create_time,
               update_time
        from raffle_activity_sku
        where sku = #{sku}
    </select>
</mapper>
