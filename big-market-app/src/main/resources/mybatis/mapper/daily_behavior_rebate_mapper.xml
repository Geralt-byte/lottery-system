<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.xjtu.infrastructure.persistent.dao.IDailyBehaviorRebateDao">

    <select id="queryDailyBehaviorRebateConfig" resultType="com.xjtu.infrastructure.persistent.po.DailyBehaviorRebate"
            parameterType="java.lang.String">
        select behavior_type,
               rebate_desc,
               rebate_type,
               rebate_config
        from daily_behavior_rebate
        where behavior_type = #{behaviorType}
          and state = 'open'
    </select>
</mapper>