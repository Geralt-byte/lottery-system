<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xjtu.infrastructure.persistent.dao.IStrategyAwardDao">

    <select id="queryStrategyAwardListByStrategyId" resultType="com.xjtu.infrastructure.persistent.po.StrategyAward">
        select strategy_id,
               award_id,
               award_count,
               award_count_surplus,
               award_rate
        from strategy_award
        where strategy_id = #{strategyId}
    </select>
</mapper>
